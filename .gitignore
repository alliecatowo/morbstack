# Swift
.build/
.swiftpm/
*.xcodeproj
DerivedData/

# Rust
target/

# Morbstack build/dev artifacts.
#
# dist/ holds vendored guest payloads: the upstream aarch64 Docker/containerd
# binaries and the Alpine rootfs tarball (~220 MB). Those are large and
# re-fetchable, so they stay out of git — but the provenance notes recording
# exactly what was downloaded, from where, and with which hash must be
# tracked, since they are the only durable record of that.
dist/*
!dist/*/
!dist/CROSS_COMPILE.md
dist/*/*
!dist/*/PROVENANCE.txt
!dist/*/TOOLCHAIN.plist

# The rules above are anchored to the repository root, so they never matched
# `mac/dist/` — which is how 21 MB of offscreen MorbShots renders got committed
# and stayed there. Those renders are also explicitly NOT visual evidence
# (docs/design/DECISIONS.md §6): an offscreen window cannot composite the
# toolbar, inspector or Liquid Glass, and screenshots from it have misled this
# project more than once. Nothing generated should be tracked from either path.
**/dist/
artifacts/

# The VS Code extension's dependencies: 146 MB, restorable with `npm ci`, and
# untracked today only by luck — nothing was stopping a `git add -A` from
# swallowing the lot.
node_modules/
integrations/vscode/out/
*.vsix

# `artifacts/` above is the working set for reviews -- dozens of captures per
# pass, regenerated every time, no reason to version them. `docs/gallery/` is
# the opposite: a small curated set that the README and the gallery page link
# to, so it IS tracked. Keep that distinction; it is what stops the repo
# re-accumulating the 22 MB of screenshots just deleted from it.
!docs/gallery/

.mise.local.toml

# Signed/packaged output. dist/* above already covers the normal locations, but
# an .app or .dmg assembled anywhere else is still hundreds of megabytes of
# re-buildable binary, and the pre-commit hook's dist/ guard would not see it.
*.app/
*.dmg

# artifacts/ is scratch space for audits and dogfooding runs. The visual evidence
# under artifacts/visual/ is deliberately tracked — docs/audit/UI-AUDIT.md cites
# it, and a screenshot nobody can find is not evidence. Everything else is the
# residue of a one-off run: artifacts/audit/ once carried a committed symlink
# whose target was one developer's absolute home path, which resolves nowhere on
# any other clone.
artifacts/*
!artifacts/visual/

# OS
.DS_Store

# Runtime data (never commit disk images or VM state)
*.img
