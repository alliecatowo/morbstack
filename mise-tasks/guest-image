#!/usr/bin/env bash
#MISE description="Build the bootable guest initramfs (cross-compiled morbinit + stock upstream Docker Engine)"
#MISE depends=["cross-build-guest"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$PWD}"

# Builds the bootable initramfs: cross-compiled morbinit as /init (also linked
# as /usr/local/bin/morbstack-docker-proxy, the userland-proxy wrapper stock
# dockerd execs per published port), plus the Alpine minirootfs and the stock
# static Docker engine binaries from dist/. Writes
# $MORBSTACK_HOME/data/kernel/initrd.img (default ~/.morbstack, override via the
# MORBSTACK_HOME env var, honoured by scripts/mkinitramfs.sh itself).
#
# `mise run app` does NOT do this. Guest-side changes are not in the bundle until
# this task runs.

scripts/mkinitramfs.sh
