#!/usr/bin/env bash
#MISE description="Report staleness and drift: is what is RUNNING what you actually BUILT?"
set -uo pipefail
# `|| exit` matters: this task sets -uo pipefail but deliberately not -e, and a
# staleness report generated from the wrong directory would confidently say
# "no drift" about a tree it never looked at.
cd "${MISE_PROJECT_ROOT:-$PWD}" || exit 1

# Every serious error in this project's history came from trusting a NAME over
# its CONTENTS:
#
#   - a daemon at the right path with an older inode still mapped, so a fixed
#     bug was re-filed as an open blocker;
#   - an initrd that predated its own source by 19 hours, so guest-side commits
#     were "tested" against code that was never in the image;
#   - a shipped dockerd that was stock upstream, not the patched build;
#   - a staged runtime that verified itself against its own manifest and so
#     could never be superseded;
#   - a `grep` that matched nothing because the directory had a different name.
#
# None of those are subtle once you look. The problem is that nothing ever
# looked. This task looks. It is read-only: it never builds, signs, starts or
# stops anything.
#
# EXIT CODES — three, not two, and the split is load-bearing:
#
#   0  everything checked agrees
#   1  the environment is INCOMPLETE (something has not been built or installed
#      yet). Normal on a fresh clone. `mise run check` reports this and moves on.
#   2  DRIFT: a thing exists under the right name but is not the thing you built.
#      `mise run check` treats this as fatal, because every conclusion you draw
#      from a tree in this state is a lie.
#
# Keeping "not built yet" out of the fatal bucket is what lets `check` call this
# at all. If a fresh clone with no guest image failed the commit gate, the gate
# would be turned off within a day and the drift detection would go with it.

MORBSTACK_HOME="${MORBSTACK_HOME:-$HOME/.morbstack}"
BUNDLE="dist/Morbstack.app"
drift=0
incomplete=0
notes=0

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
warn()  { printf '\033[33m%s\033[0m\n' "$*"; }

# FAIL  = drift (exit 2). Use only when a name and its contents disagree.
# TODO  = not built/installed yet (exit 1). Use when the answer is "run X".
# NOTE  = informational (exit 0).
fail() { red   "  FAIL  $1"; drift=$((drift + 1)); }
todo() { warn  "  TODO  $1"; incomplete=$((incomplete + 1)); }
note() { warn  "  NOTE  $1"; notes=$((notes + 1)); }
ok()   { green "  ok    $1"; }

# mtime as epoch seconds, or 0 when the file is absent.
mtime() { [ -e "$1" ] && stat -f %m "$1" 2>/dev/null || echo 0; }
human() { [ -e "$1" ] && stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$1" 2>/dev/null || echo "(absent)"; }

echo "== guest image =="

INITRD_BUILT="${MORBSTACK_HOME}/data/kernel/initrd.img"
# `current` is a symlink to a version directory, and the bundle nests its payload
# under that same version. Resolve both rather than hardcoding "0.1.0-m0", so this
# keeps working after a version bump instead of quietly checking nothing.
INITRD_STAGED="${MORBSTACK_HOME}/data/runtime/current/kernel/initrd.img"
BUNDLE_INITRD=$(find "${BUNDLE}/Contents/Resources/runtime" -type f -path '*/kernel/initrd.img' 2>/dev/null | head -1)
BUNDLE_INITRD="${BUNDLE_INITRD:-${BUNDLE}/Contents/Resources/runtime/<version>/kernel/initrd.img}"

# A check that silently does not run is the same disease this task exists to
# cure, so assert the paths we are about to compare actually exist.
for probe in "$BUNDLE_INITRD:bundle" "$INITRD_STAGED:staged"; do
	p="${probe%:*}"; label="${probe##*:}"
	[ -e "$p" ] || note "no ${label} initrd at ${p} — that comparison is being skipped"
done

# The daemon boots runtime/current, which is staged FROM THE APP BUNDLE -- not
# data/kernel/, which is where `mise run guest-image` writes. So the loop is
# guest-image -> app -> restart. Running guest-image alone changes nothing at
# runtime, which is exactly the trap that cost hours.
if [ ! -e "$INITRD_BUILT" ]; then
	todo "no guest image built at ${INITRD_BUILT} — run: mise run guest-image"
else
	guest_src_mtime=0
	while IFS= read -r f; do
		m=$(mtime "$f")
		[ "$m" -gt "$guest_src_mtime" ] && guest_src_mtime=$m
	done < <(find guest -type f \( -name '*.rs' -o -name '*.patch' -o -name '*.toml' \) 2>/dev/null)

	if [ "$guest_src_mtime" -gt "$(mtime "$INITRD_BUILT")" ]; then
		fail "guest/ is NEWER than the built image — your guest changes are not in it"
		echo "          built:  $(human "$INITRD_BUILT")"
		echo "          source: $(date -r "$guest_src_mtime" '+%Y-%m-%d %H:%M')"
		echo "          fix:    mise run guest-image && mise run app"
	else
		ok "built image is newer than guest/ ($(human "$INITRD_BUILT"))"
	fi

	# Is the built image the one that will actually boot?
	if [ -e "$BUNDLE_INITRD" ]; then
		if ! cmp -s "$INITRD_BUILT" "$BUNDLE_INITRD"; then
			fail "the app bundle carries a DIFFERENT guest image than you last built"
			echo "          fix: mise run app   (re-stages the bundle from dist/)"
		else
			ok "app bundle carries the image you built"
		fi
	fi
	if [ -e "$INITRD_STAGED" ] && [ -e "$BUNDLE_INITRD" ]; then
		if ! cmp -s "$INITRD_STAGED" "$BUNDLE_INITRD"; then
			fail "the STAGED runtime differs from the bundle — the VM boots the staged copy"
			echo "          staged: $(human "$INITRD_STAGED")"
			echo "          fix:    restart the daemon so it re-stages, or morb stop && morb start"
		else
			ok "staged runtime matches the bundle (this is what boots)"
		fi
	fi
fi

echo
echo "== Docker Engine =="

# The engine is the unmodified upstream static dockerd; `docker run -P` is
# served by the morbstack-docker-proxy wrapper (a link to morbinit inside the
# guest image), so the checks here are presence, not patch state.
STOCK_DOCKERD="dist/guest-bin/dockerd"
if [ ! -e "$STOCK_DOCKERD" ]; then
	todo "no stock engine at ${STOCK_DOCKERD} — run: scripts/fetch-guest-assets.sh --docker-only"
elif [ -e "dist/guest-bin/morbstack-dockerd" ]; then
	fail "dist/guest-bin/morbstack-dockerd still exists — the patched-engine pipeline was removed; delete it so nothing stale can be mistaken for the engine"
else
	ok "stock upstream engine present ($(human "$STOCK_DOCKERD"))"
fi

echo
echo "== running daemon =="

# Same path, different inode. This one re-filed a fixed bug as an open blocker.
daemon_pid=$(pgrep -f "Morbstack.app/Contents/MacOS/morbstackd" | head -1)
if [ -z "$daemon_pid" ]; then
	note "no daemon running (fine if you meant that)"
else
	on_disk="${BUNDLE}/Contents/MacOS/morbstackd"
	running_path=$(ps -o comm= -p "$daemon_pid" 2>/dev/null)
	if [ -e "$on_disk" ]; then
		disk_mtime=$(mtime "$on_disk")
		# Process start time in epoch seconds.
		started=$(ps -o lstart= -p "$daemon_pid" 2>/dev/null)
		started_epoch=$(date -j -f "%a %b %d %T %Y" "$started" +%s 2>/dev/null || echo 0)
		if [ "$started_epoch" -ne 0 ] && [ "$disk_mtime" -gt "$started_epoch" ]; then
			fail "daemon PID ${daemon_pid} started BEFORE the binary on disk was built"
			echo "          started: $(date -r "$started_epoch" '+%Y-%m-%d %H:%M')"
			echo "          binary:  $(human "$on_disk")"
			echo "          it has the OLD inode mapped. Results from it are stale."
			echo "          fix:     morb stop && morb start"
		else
			ok "daemon PID ${daemon_pid} is newer than its binary"
		fi
	fi
	[ -n "$running_path" ] && echo "          argv: ${running_path}"
fi

echo
echo "== code signing =="

# `swift build` strips the virtualization entitlement, and `codesign --deep`
# silently strips it too. Without it the engine can never boot a VM -- and the
# app looks perfectly fine until someone tries.
SIGNED_D="${BUNDLE}/Contents/MacOS/morbstackd"
if [ -e "$SIGNED_D" ]; then
	if codesign -d --entitlements - "$SIGNED_D" 2>/dev/null | grep -q "com.apple.security.virtualization"; then
		ok "bundled morbstackd carries the virtualization entitlement"
	else
		fail "bundled morbstackd has NO virtualization entitlement — it cannot boot a VM"
		echo "          fix: mise run app   (signs inside-out; never use codesign --deep)"
	fi
else
	todo "no assembled bundle — run: mise run app"
fi

# The debug daemon is signed by `mise run sign`, and EVERY `swift build` after
# that strips the entitlement again. The bundle check above says nothing about
# it, so a developer running `mise run run-daemon` after an unrelated rebuild
# gets a daemon that fails to open a VM with a confusing error. Two binaries,
# two independent signatures, two checks.
DEBUG_D="mac/.build/debug/morbstackd"
if [ -e "$DEBUG_D" ]; then
	if codesign -d --entitlements - "$DEBUG_D" 2>/dev/null | grep -q "com.apple.security.virtualization"; then
		ok "debug morbstackd carries the virtualization entitlement"
	else
		fail "debug morbstackd lost its entitlement to a later swift build"
		echo "          fix: mise run sign   (must be the LAST step before starting it)"
	fi
else
	note "no debug daemon built (fine unless you use mise run run-daemon)"
fi

echo
echo "== toolchain =="

if rustc --print target-libdir --target aarch64-unknown-linux-musl >/dev/null 2>&1; then
	ok "guest Rust target installed (aarch64-unknown-linux-musl)"
else
	todo "guest Rust target missing — the guest's Linux-only code is NOT type-checked"
	echo "          this is how 13 guest compile errors shipped while 217 host tests passed"
	echo "          fix: rustup target add aarch64-unknown-linux-musl"
fi

# Pinned in mise.toml so `mise run check` can lint the same set CI lints. If the
# shim is missing, check silently downgrades to a warning and the local gate
# stops matching CI -- which is the whole reason the pin exists.
if command -v shellcheck >/dev/null 2>&1; then
	ok "shellcheck available ($(shellcheck --version 2>/dev/null | awk '/^version:/ {print $2}'))"
else
	todo "shellcheck missing — mise run check cannot lint what CI lints. fix: mise install"
fi

echo
echo "== repository =="

if [ -z "$(git remote 2>/dev/null)" ]; then
	todo "no git remote — CI cannot run"
else
	ok "remote: $(git remote get-url origin 2>/dev/null)"
fi

# `mise run install-hooks` sets core.hooksPath; it does NOT write
# .git/hooks/pre-commit. Checking the latter meant this line reported "not
# installed" forever, no matter how many times someone installed the hooks --
# a check that can only ever produce one answer is not a check.
HOOKS_PATH=$(git config --get core.hooksPath 2>/dev/null || true)
if [ -n "$HOOKS_PATH" ] && [ -x "${HOOKS_PATH}/pre-commit" ]; then
	ok "pre-commit hook installed (core.hooksPath -> ${HOOKS_PATH})"
elif [ -x .git/hooks/pre-commit ]; then
	note "a pre-commit hook is copied into .git/hooks — the tracked one in"
	echo "          scripts/git-hooks will not update it. fix: mise run install-hooks"
else
	todo "pre-commit hook not installed — run: mise run install-hooks"
fi

echo
if [ "$drift" -ne 0 ]; then
	red "${drift} drift problem(s): what you are running is not what you built"
	exit 2
fi
if [ "$incomplete" -ne 0 ]; then
	warn "${incomplete} thing(s) not built or installed yet (no drift detected)"
	exit 1
fi
green "no drift detected${notes:+ (${notes} note(s) above)}"
exit 0
