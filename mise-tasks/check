#!/usr/bin/env bash
#MISE description="Fast pre-commit gate: compile everything including tests, then run the unit suites"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$PWD}"

# CI runs now (github.com/alliecatowo/morbstack) — this header used to say it
# never had, which a comment further down already contradicted by name. THIS is
# still the gate that matters, because it is the one that runs before the commit
# rather than after the push. Keep it fast — compile plus unit tests, no bundle
# assembly, no guest image, no VM — so nobody is tempted to skip it.
#
# `swift build` alone does NOT compile the test target. Four test files in this
# repository were committed in a state where they could never compile, precisely
# because every check that ran was `swift build` without --build-tests.
status=0

echo "==> swift build --build-tests"
swift build --package-path mac --build-tests || status=1

echo "==> cargo build"
(cd guest/morbinit && cargo build) || status=1

# The host build above type-checks almost none of the code that actually runs in
# the VM: ~85 `#[cfg(target_os = "linux")]` gates across 19 of 22 files compile
# away on macOS. The live-share transport shipped with 13 compile errors for the
# real target while `cargo test` reported 217 passing tests, and a commit titled
# "Fix live-share transport compilation" fixed only the macOS side. `cargo check`
# needs the target's std but no cross-linker, so this is seconds, not minutes.
GUEST_TARGET="aarch64-unknown-linux-musl"
if (cd guest/morbinit && rustc --print target-libdir --target "$GUEST_TARGET") >/dev/null 2>&1; then
	echo "==> cargo check --target ${GUEST_TARGET} (the code that really runs in the guest)"
	(cd guest/morbinit && cargo check --target "$GUEST_TARGET" --all-targets) || status=1
else
	echo "warning: ${GUEST_TARGET} std is not installed, so the guest's Linux-only" >&2
	echo "         code is NOT being checked. Install it with:" >&2
	echo "           rustup target add ${GUEST_TARGET}" >&2
	echo "         This is the exact gap that let 13 guest compile errors ship." >&2
fi

if [ "$status" -ne 0 ]; then
	echo "error: compilation failed — not running tests" >&2
	exit "$status"
fi

echo "==> swift test"
(cd mac && swift test) || status=1

echo "==> cargo test"
(cd guest/morbinit && cargo test) || status=1

echo "==> cargo fmt --check"
(cd guest/morbinit && cargo fmt -- --check) || status=1

# CI runs clippy with -D warnings. If this gate does not, a lint that is fatal in
# CI is invisible locally -- which is exactly how a `useless_conversion` in
# sha256.rs reached the first CI run this project ever had. Whatever CI treats as
# fatal, this must treat as fatal too, or the local gate is not a gate.
echo "==> cargo clippy -D warnings (host)"
(cd guest/morbinit && cargo clippy --all-targets -- -D warnings) || status=1

# And again for the target that actually runs. Host-only clippy misses the
# Linux-gated code entirely -- the same hole that let 13 compile errors ship
# while `cargo test` reported 217 passing. It is not hypothetical here: this
# invocation found two real lints (a dead protocol variant and a
# write_with_newline) that the host run above is structurally incapable of
# seeing. Whatever we lint, lint it where it runs.
if (cd guest/morbinit && rustc --print target-libdir --target "$GUEST_TARGET") >/dev/null 2>&1; then
	echo "==> cargo clippy -D warnings (${GUEST_TARGET})"
	(cd guest/morbinit && cargo clippy --all-targets --target "$GUEST_TARGET" -- -D warnings) || status=1
fi

# Same rule as clippy: CI shellchecks these, so this gate must too. shellcheck is
# pinned in mise.toml, so `mise run check` supplies it rather than expecting a
# brew install. Keep the invocation byte-identical to ci.yml's — a local gate that
# lints a different set than CI is a gate that lies.
echo "==> shellcheck"
if command -v shellcheck >/dev/null 2>&1; then
	shellcheck scripts/*.sh scripts/git-hooks/pre-commit || status=1
	shellcheck --shell=bash mise-tasks/* || status=1
	shellcheck integrations/shell/morb.bash || status=1
else
	echo "warning: shellcheck not found; run 'mise install' (CI will still lint)" >&2
fi

# The other two completions are not shell dialects shellcheck knows, so they get
# their own interpreter's parser instead. What each file *declares* is checked by
# ShellCompletionDriftTests in the Swift suite above -- this only proves they
# parse. fish is genuinely optional and is skipped rather than faked.
echo "==> shell completions parse"
bash -n integrations/shell/morb.bash || status=1
zsh -n integrations/shell/_morb || status=1
if command -v fish >/dev/null 2>&1; then
	fish --no-execute integrations/shell/morb.fish || status=1
else
	echo "note: fish not installed; morb.fish was not parse-checked" >&2
fi

# Third thing CI's lint job treats as fatal, and the last one this gate was
# missing. A task that is not executable, has no description, or does not parse
# is not a syntax error anywhere -- it just quietly vanishes from `mise tasks`,
# and the next person concludes the task was never written. Keep this equivalent
# to ci.yml's "Validate mise task files" step.
echo "==> mise task files"
mise tasks >/dev/null || status=1
for task in mise-tasks/*; do
	[ -x "$task" ] || { echo "not executable: $task" >&2; status=1; }
	grep -q '^#MISE description=' "$task" \
		|| { echo "missing '#MISE description=': $task" >&2; status=1; }
	bash -n "$task" || status=1
done

# Drift, last, and ADVISORY — the exit code is reported, not inherited.
#
# Read the reasoning before "fixing" this to be fatal. `check` is a source gate:
# it compiles the tree and runs unit tests, and none of its conclusions depend on
# the initramfs, the app bundle, or which daemon is running. Blocking a docs
# commit because somebody's staged runtime is a day old is a category error, and
# a gate that fails for reasons unrelated to the diff gets switched off within a
# week — taking the real drift detection with it.
#
# Drift IS fatal where it changes the answer: `mise run dev` ends with doctor and
# inherits its status, because that task's entire claim is "the thing you built is
# now the thing that runs."
#
# `|| doctor_status=$?` and not a bare call: this task runs under `set -e`, so a
# bare `mise run doctor` would abort the script before the report below.
echo "==> doctor (advisory)"
doctor_status=0
mise run doctor || doctor_status=$?
case "$doctor_status" in
0) ;;
1) echo "note: environment incomplete (TODO lines above) — not a gate failure" >&2 ;;
*)
	echo >&2
	echo "  *** DRIFT: what you are running is not what you built. ***" >&2
	echo "  Your commit is not blocked, but no runtime claim from this tree is" >&2
	echo "  trustworthy until you run: mise run dev" >&2
	echo >&2
	;;
esac

# `swift build --build-tests` above just stripped com.apple.security.virtualization
# off mac/.build/debug/morbstackd (CLAUDE.md §1.1). Running the gate therefore
# breaks the dev daemon every single time, silently, and the symptom appears much
# later as a VM that will not open. Say so here, where the cause is.
if [ -x mac/.build/debug/morbstackd ]; then
	echo
	echo "note: this run re-signed mac/.build/debug/morbstackd without entitlements."
	echo "      re-sign before starting it:  mise run sign"
fi

if [ "$status" -ne 0 ]; then
	echo "error: mise run check failed (see output above)" >&2
fi
exit "$status"
