#!/usr/bin/env bash
#MISE description="Build morbinit (Rust, guest PID 1), host arch"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$PWD}"

# NOTE: on macOS this only type-checks the portable subset of morbinit. Roughly
